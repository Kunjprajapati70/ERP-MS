{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://erp-ms-mwkj.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://erp-ms-mwkj.onrender.com/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
